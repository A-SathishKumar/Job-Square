# Job Square Enterprise Backend Configuration & Security Environment
PORT=3000
NODE_ENV=production

# Database Configuration (MongoDB cluster URI; defaults to high-integrity in-memory store if unset)
MONGODB_URI=mongodb+srv://jobsquare_admin:SecretPassword@cluster0.mongodb.net/jobsquare?retryWrites=true&w=majority

# JWT Authentication (HS256 secret key for signing executive session tokens)
JWT_SECRET=jobsquare_enterprise_production_jwt_secret_key_super_secure_2026_OWASP

# CORS Allowed Origins (Comma-separated exact origins, no wildcards when credentials enabled)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://jobsquare.advisory

# IP Anonymization Salt for OWASP Audit Tracking
IP_SALT=jobsquare_audit_ip_salt_string_2026

# Corporate Transactional SMTP (Optional; falls back to structured logger if omitted)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.example_key_here
SMTP_FROM=advisory@jobsquare.advisory
